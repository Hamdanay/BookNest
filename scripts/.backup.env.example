# ==============================================================================
# Template Konfigurasi Notifikasi Telegram untuk Backup BookNest
# Salin file ini menjadi .backup.env lalu isi dengan Token & Chat ID milikmu:
# cp .backup.env.example .backup.env
# ==============================================================================

TELEGRAM_BOT_TOKEN=masukkan_bot_token_disini
TELEGRAM_CHAT_ID=masukkan_chat_id_disini
