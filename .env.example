# ==============================================================================
# BookNest Environment Configuration Template (.env.example)
# Salin file ini menjadi '.env' untuk menyesuaikan konfigurasi lokal
# ==============================================================================

# 1. Environment Node.js
NODE_ENV=production

# 2. Port Layanan
# Port internal backend (Express.js)
BACKEND_PORT=3002

# Port publik reverse proxy Nginx (Akses via browser http://localhost:8080)
FRONTEND_PORT=8080

# 3. Konfigurasi Notifikasi & Off-site Backup Telegram (Opsional / Rahasia)
# Dapatkan token bot dari @BotFather dan chat_id dari @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
